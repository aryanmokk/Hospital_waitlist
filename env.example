# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=waitlists
PG_USER=teamproj
PG_PASSWORD=teamproj

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=hse_raw

# OpenRouteService (free tier — sign up at https://openrouteservice.org/dev/)
ORS_API_KEY=

# Optional — override default paths
DATA_DIR=./data
CACHE_DIR=./data/cache
